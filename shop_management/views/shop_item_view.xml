<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_shop_item_list" model="ir.ui.view">
        <field name="name">shop.item.list</field>
        <field name="model">shop.item</field>
        <field name="arch" type="xml">
            <list class="o_list_table_fixed" >
                <field name="date" />
                <field name="name" string="Shop Item" />
                <field name="quantity" />
                <field name="number"/>
                <field name="is_available" optional="True"  />

            </list>
        </field>
    </record>

    <record id="view_shop_item_form" model="ir.ui.view">
        <field name="name">shop.item.form</field>
        <field name="model">shop.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="number" />
                            <field name="quantity" />
                        </group>
                        <group>
                            <field name="is_available"/>
                            <field name="date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shop_item" model="ir.actions.act_window">
        <field name="name">Shop Item</field>
        <field name="res_model">shop.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>