<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_school_subject_form" model="ir.ui.view">
        <field name="name">school.subject.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Subject Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Math"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="description" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_subject_list" model="ir.ui.view">
        <field name="name">school.subject.list</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <list string="subject">
                <field name="name" />
                <field name="code" />
                <field name="description" />
            </list>
        </field>
    </record>

    <record id="action_school_subject_view" model="ir.actions.act_window">
        <field name="name">School Subject</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>