<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_school_teacher_form" model="ir.ui.view">
        <field name="name">school_teacher_form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Teacher Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Hla Hla"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="employee_id"/>
                            <field name="phone" />
                            <field name="email" />
                        </group>
                        <group string="Work Information">
                            <field name="date_joined" />
                            <field name="subject_id" />
                            <field name="active" invisible="True" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_teacher_list" model="ir.ui.view">
        <field name="name">school.teacher.list</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id" />
                <field name="phone" />
                <field name="email" />
                <field name="date_joined" />
                <field name="subject_id" />
            </list>
        </field>
    </record>

    <record id="action_school_teacher_view" model="ir.actions.act_window">
        <field name="name">School Teacher</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>